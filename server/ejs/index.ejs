<!-- File: server/ejs/index.ejs
     Description: Main homepage template for application
     Purpose: Displays the main page with text submission form and recent submissions
     Notes: Uses EJS templating with server-provided configuration values -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <title><%= page.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" nonce="<%= page.nonce %>"></script>
    <script src="/js/logout.js" nonce="<%= page.nonce %>"></script>
    <script src="/js/modalManager.js" nonce="<%= page.nonce %>"></script>
    
    <!-- Cross-tab logout synchronization -->
    <script nonce="<%= page.nonce %>">
        /**
         * Cross-tab logout synchronization
         * 
         * WHAT:
         * We listen for logout events from other tabs and instantly sync the UI.
         *
         * WHY:
         * When a user logs out in one tab, all other tabs should immediately show
         * the logged-out state for consistent UX.
         *
         * HOW:
         * Uses BroadcastChannel to communicate between tabs and redirects to homepage
         * when logout is detected from another tab.
         */
        try {
            const bc = new BroadcastChannel('auth');
            
            // Listen for logout events from other tabs
            bc.onmessage = (e) => {
                if (e?.data?.type === 'LOGOUT') {
                    // Drop any local UI state and hard-redirect to homepage
                    window.location.replace('/');
                }
            };
            
            // Clean up when page unloads
            window.addEventListener('beforeunload', () => {
                try { bc.close(); } catch {}
            });
        } catch (error) {
            // BroadcastChannel not supported - continue without cross-tab sync
            console.warn('Cross-tab logout sync not available');
        }
    </script>
</head>
<body>
    <header>
        <nav>
            <div class="container">
                <h1><%= app_info?.name || 'Application' %></h1>
                <div class="nav-content">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/health">Health</a></li>
                        <li><a href="/api/hello">API</a></li>
                    </ul>
                    <div class="auth-section">
                        <% if (user.isAuthenticated) { %>
                            <a href="/dashboard" class="dashboard-link btn btn-primary">Dashboard</a>
                            <button id="logoutBtn" type="button" class="btn btn-secondary">Logout</button>
                        <% } else { %>
                            <a href="#" class="login-link">Login</a>
                            <a href="#" class="signup-link">Sign Up</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <div class="hero">
                <h1>Welcome to <%= app_info?.name || 'Application' %></h1>
                <p class="subtitle"><%= page.description %></p>
                <div class="cta-buttons">
                    <a href="/health" class="btn btn-primary">Check Health</a>
                    <a href="/api/hello" class="btn btn-primary">API Test</a>
                </div>
            </div>

            <div class="text-submission">
                <h2>Text Submission Demo</h2>
                <p>Enter text below to test backend validation:</p>
                <form id="textForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group">
                        <textarea 
                            id="textInput" 
                            name="text" 
                            placeholder="Enter your text here (minimum <%= features.textLimits.min %> characters, maximum <%= features.textLimits.max %> characters)..."
                            rows="4"
                            maxlength="<%= features.textLimits.max %>"
                        ></textarea>
                        <div class="char-count">
                            <span id="charCount">0</span> / <%= features.textLimits.max %> characters
                        </div>
                    </div>
                    <button type="submit" class="btn btn-secondary">Submit Text</button>
                </form>
                <div id="result" class="result-message"></div>
                <div class="submission-actions">
                    <button id="viewSubmissionsBtn" class="btn btn-secondary">View Recent Submissions</button>
                </div>
                <div id="submissionsList" class="submissions-list"></div>
            </div>

            <div class="features">
                <div class="feature-grid">
                    <div class="feature-card">
                        <h3>Secure by Design</h3>
                        <p>Built with strong security middleware including Helmet, CORS, and rate limiting.</p>
                    </div>
                    <div class="feature-card">
                        <h3>Clean Code</h3>
                        <p>Built with simple and reliable code.</p>
                    </div>
                    <div class="feature-card">
                        <h3>EJS Frontend</h3>
                        <p>Starting with EJS templates, ready for future Next.js migration when needed.</p>
                    </div>
                </div>
            </div>

            <div class="status">
                <h2>Server Status</h2>
                <div class="status-item">
                    <span class="status-label">API Endpoint:</span>
                    <span class="status-value">Active</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Security Middleware:</span>
                    <span class="status-value">Enabled</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Rate Limiting:</span>
                    <span class="status-value">100 req/15min</span>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <!-- Centralized Modals (login, signup, notifications) -->
    <%- include('partials/modals') %>

    <!-- Pass server config to client-side JavaScript via data attributes -->
    <div id="app-config" 
         class="hidden"
         data-text-min-length="<%= features.textLimits.min %>" 
         data-text-max-length="<%= features.textLimits.max %>"
         data-supabase-url="<%= process.env.SUPABASE_URL %>"
         data-supabase-anon-key="<%= process.env.SUPABASE_ANON_KEY %>"></div>
    <script src="/js/main.js" nonce="<%= page.nonce %>"></script>
</body>
</html>
