<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Authentication required - <%= app_info?.name || 'Application' %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || Date.now() %>">
</head>
<body>
  <header>
    <nav class="container">
      <a href="/" class="btn btn-small">Home</a>
    </nav>
  </header>
  
  <main class="container" style="padding: 4rem 1rem; text-align: center;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">401</h1>
    <h2 style="margin-bottom: 1.5rem;">Authentication required</h2>
    <p style="margin-bottom: 2rem;">Please sign in to access this page.</p>
    <div style="margin-top: 2rem;">
      <a href="/login" class="btn btn-primary">Sign in</a>
    </div>
    <p class="text-muted" style="font-size: 0.875rem; margin-top: 2rem;">Request ID: <%= requestId %></p>
  </main>
  
  <footer class="container" style="text-align: center; padding: 2rem 0;">
    <p>&copy; <%= new Date().getFullYear() %> <%= app_info?.name || 'Application' %></p>
  </footer>
</body>
</html>

