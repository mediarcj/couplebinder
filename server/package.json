    "helmet": "^7.1.0",
    "jose": "^6.1.0",
    "micromatch": "^4.0.8",
    "rate-limiter-flexible": "^5.0.3",
    "redis": "4.6.14",
    "sanitize-html": "^2.17.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-vitest": "^0.5.4",
