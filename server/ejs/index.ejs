<!-- File: server/ejs/index.ejs
     Description: Main homepage template for Detechify
     Purpose: Displays the main page with text submission form and recent submissions
     Notes: Uses EJS templating with server-provided configuration values -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Detechify</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav>
            <div class="container">
                <h1>Detechify</h1>
                <div class="nav-content">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/health">Health</a></li>
                        <li><a href="/api/hello">API</a></li>
                    </ul>
                    <div class="auth-section">
                        <a href="#" class="login-link" onclick="handleLogin(); return false;">Login</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <div class="hero">
                <h1>Welcome to Detechify</h1>
                <p class="subtitle"><%= message %></p>
                <div class="cta-buttons">
                    <a href="/health" class="btn btn-primary">Check Health</a>
                    <a href="/api/hello" class="btn btn-primary">API Test</a>
                </div>
            </div>

            <div class="text-submission">
                <h2>Text Submission Demo</h2>
                <p>Enter text below to test backend validation:</p>
                <form id="textForm">
                    <div class="form-group">
                        <textarea 
                            id="textInput" 
                            name="text" 
                            placeholder="Enter your text here (minimum <%= textMinLength %> characters, maximum <%= textMaxLength %> characters)..."
                            rows="4"
                            maxlength="<%= textMaxLength %>"
                        ></textarea>
                        <div class="char-count">
                            <span id="charCount">0</span> / <%= textMaxLength %> characters
                        </div>
                    </div>
                    <button type="submit" class="btn btn-secondary">Submit Text</button>
                </form>
                <div id="result" class="result-message"></div>
                <div class="submission-actions">
                    <button id="viewSubmissionsBtn" class="btn btn-secondary">View Recent Submissions</button>
                </div>
                <div id="submissionsList" class="submissions-list"></div>
            </div>

            <div class="features">
                <div class="feature-grid">
                    <div class="feature-card">
                        <h3>Secure by Design</h3>
                        <p>Built with enterprise-grade security middleware including Helmet, CORS, and rate limiting.</p>
                    </div>
                    <div class="feature-card">
                        <h3>Modern Architecture</h3>
                        <p>Built with clean, maintainable, and scalable code structure.</p>
                    </div>
                    <div class="feature-card">
                        <h3>EJS Frontend</h3>
                        <p>Starting with EJS templates, ready for future Next.js migration when needed.</p>
                    </div>
                </div>
            </div>

            <div class="status">
                <h2>Server Status</h2>
                <div class="status-item">
                    <span class="status-label">API Endpoint:</span>
                    <span class="status-value">Active</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Security Middleware:</span>
                    <span class="status-value">Enabled</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Rate Limiting:</span>
                    <span class="status-value">100 req/15min</span>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 Detechify. Building the future of tech detection.</p>
        </div>
    </footer>

    <!-- Pass server config to client-side JavaScript via data attributes -->
    <div id="app-config" 
         data-text-min-length="<%= textMinLength %>" 
         data-text-max-length="<%= textMaxLength %>" 
         style="display: none;"></div>
    <script>
        // Extract config from data attributes
        const configEl = document.getElementById('app-config');
        window.appConfig = {
            textMinLength: parseInt(configEl.dataset.textMinLength),
            textMaxLength: parseInt(configEl.dataset.textMaxLength)
        };

        // Login button handler (placeholder for future functionality)
        function handleLogin() {
            alert('Login functionality coming soon!');
        }
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
