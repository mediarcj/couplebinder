<!-- File: server/ejs/dashboard.ejs
     Description: Protected dashboard template for authenticated users
     Purpose: Displays user dashboard with profile info and navigation
     Notes: Uses consistent UI/UX with main homepage template -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <title><%= page.title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav>
            <div class="container">
                <h1><%= app_info?.name || 'Application' %></h1>
                <div class="nav-content">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/health">Health</a></li>
                        <li><a href="/api/hello">API</a></li>
                        <li><a href="/dashboard" class="active">Dashboard</a></li>
                    </ul>
                    <div class="auth-section">
                        <span class="user-info">Welcome, <%= user.display_name %>!</span>
                        <button id="logoutBtn" type="button" class="btn btn-secondary">Logout</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <div class="hero">
                <h1>Welcome to Your Dashboard</h1>
                <p class="subtitle">Hello <%= user.display_name %>, you're successfully logged in!</p>
                <div class="cta-buttons">
                    <a href="/health" class="btn btn-primary">Check Health</a>
                    <a href="/api/hello" class="btn btn-primary">API Test</a>
                </div>
            </div>

            <div class="user-profile">
                <h2>Your Profile</h2>
                <div class="profile-card">
                    <div class="profile-info">
                        <div class="info-item">
                            <span class="info-label">Display Name:</span>
                            <span class="info-value"><%= user.display_name || 'Not set' %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Email:</span>
                            <span class="info-value"><%= user.email %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Phone:</span>
                            <span class="info-value"><%= user.phone || 'Not provided' %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Member Since:</span>
                            <span class="info-value"><%= user.created_at ? new Date(user.created_at).toLocaleDateString() + ' ' + new Date(user.created_at).toLocaleTimeString('en-US', {hour: 'numeric', minute: '2-digit', hour12: true}) : 'Unknown' %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Last Sign In:</span>
                            <span class="info-value"><%= user.last_sign_in_at ? new Date(user.last_sign_in_at).toLocaleDateString() + ' ' + new Date(user.last_sign_in_at).toLocaleTimeString('en-US', {hour: 'numeric', minute: '2-digit', hour12: true}) : 'Unknown' %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Email Confirmed:</span>
                            <span class="info-value"><%= user.email_confirmed === true ? 'Yes' : 'No' %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Provider:</span>
                            <span class="info-value"><%= user.providers ? user.providers.join(', ') : 'email' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-actions">
                <h2>Quick Actions</h2>
                <div class="action-grid">
                    <div class="action-card">
                        <h3>Text Submission</h3>
                        <p>Submit text for processing and analysis.</p>
                        <a href="/" class="btn btn-primary">Go to Submission</a>
                    </div>
                    <div class="action-card">
                        <h3>View Submissions</h3>
                        <p>Check your recent text submissions.</p>
                        <button id="viewSubmissionsBtn" class="btn btn-secondary">View Recent</button>
                    </div>
                    <div class="action-card">
                        <h3>Edit Profile</h3>
                        <p>Update your profile information and preferences.</p>
                        <a href="/dashboard/profile-edit" class="btn btn-secondary">Edit Profile</a>
                    </div>
                </div>
            </div>

            <div class="status">
                <h2>Account Status</h2>
                <div class="status-item">
                    <span class="status-label">Authentication:</span>
                    <span class="status-value status-success">Active</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Session:</span>
                    <span class="status-value status-success">Valid</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Account Type:</span>
                    <span class="status-value">Standard</span>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <!-- Hidden submissions list for dashboard -->
    <div id="submissionsList" class="submissions-list" style="display: none;"></div>

    <!-- Supabase client initialization -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" nonce="<%= page.nonce %>"></script>
    <div id="app-config" 
         data-supabase-url="<%= ui.supabaseUrl %>" 
         data-supabase-anon-key="<%= ui.supabaseAnonKey %>" 
         style="display:none;">
    </div>
    <script nonce="<%= page.nonce %>">
        // Initialize Supabase client for dashboard
        if (typeof supabase !== 'undefined') {
            const configEl = document.getElementById('app-config');
            if (configEl) {
                const supabaseUrl = configEl.dataset.supabaseUrl;
                const supabaseAnonKey = configEl.dataset.supabaseAnonKey;
                if (supabaseUrl && supabaseAnonKey) {
                    window.supabase = supabase.createClient(supabaseUrl, supabaseAnonKey);
                    // Do not console log.
                }
            }
        }
    </script>
    <script src="/js/dashboard.js" nonce="<%= page.nonce %>"></script>
</body>
</html>