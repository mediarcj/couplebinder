# --- Branding & infra (optional; code has safe fallbacks) ---

# Base apex domain used for CORS / infra examples (e.g., detechify.com)
BASE_DOMAIN=

# The subdomain used for the app (e.g., app)
APP_SUBDOMAIN=app

# Old cookie domain used only to clear legacy cookies (e.g., .detechify.com)
LEGACY_COOKIE_DOMAIN=

# Header for Supabase client identification
X_CLIENT_INFO=app-server/1.0.0
