<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
  <meta id="app-config" data-supabase-url="<%= ui.supabaseUrl %>" data-supabase-anon-key="<%= ui.supabaseAnonKey %>">
  <title>Billing – <%= app_info?.name || 'Detechify' %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || Date.now() %>">
</head>
<body>
  <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>

  <main>
    <div class="container">
      <div class="hero">
        <h1>Billing</h1>
        <p class="subtitle">Secure payments are powered by Stripe. We never store card numbers.</p>
      </div>

      <div class="action-grid">
        <% 
          const pOne = (billing?.pricing || []).find(p => p.priceId === env?.STRIPE_PRICE_RESUME_ONE_TIME);
          const pTwo = (billing?.pricing || []).find(p => p.priceId === env?.STRIPE_PRICE_RESUME_EXPERT);
        %>
        <% if (pOne) { %>
        <div class="action-card">
          <% if (pOne.image) { %>
            <img
              class="product-img"
              src="<%= pOne.image %>"
              alt="<%= pOne.name || '' %>"
              loading="lazy"
              decoding="async">
          <% } %>
          <% if (pOne.name) { %><h3><%= pOne.name %></h3><% } %>
          <% if (pOne.description) { %><p><%= pOne.description %></p><% } %>
          <% if (Number.isFinite(pOne.unit_amount)) { %>
          <p class="price">
            $<%= (pOne.unit_amount / 100).toFixed(0) %> <%= (pOne.currency || '').toUpperCase() %>
            <%= pOne.isRecurring ? `/${pOne.interval}` : ' one-time' %>
          </p>
          <% } %>
          <button class="btn btn-primary" 
                  id="buyResumeBasic"
                  data-price-id="<%= pOne.priceId %>"
                  data-price-type="<%= pOne.isRecurring ? 'recurring' : 'one_time' %>">
            Buy<%= pOne.name ? ` ${pOne.name}` : '' %>
          </button>
        </div>
        <% } %>

        <% if (pTwo) { %>
        <div class="action-card">
          <% if (pTwo.image) { %>
            <img
              class="product-img"
              src="<%= pTwo.image %>"
              alt="<%= pTwo.name || '' %>"
              loading="lazy"
              decoding="async">
          <% } %>
          <% if (pTwo.name) { %><h3><%= pTwo.name %></h3><% } %>
          <% if (pTwo.description) { %><p><%= pTwo.description %></p><% } %>
          <% if (Number.isFinite(pTwo.unit_amount)) { %>
          <p class="price">
            $<%= (pTwo.unit_amount / 100).toFixed(0) %> <%= (pTwo.currency || '').toUpperCase() %>
            <%= pTwo.isRecurring ? `/${pTwo.interval}` : ' one-time' %>
          </p>
          <% } %>
          <button class="btn btn-secondary" 
                  id="buyResumeExpert"
                  data-price-id="<%= pTwo.priceId %>"
                  data-price-type="<%= pTwo.isRecurring ? 'recurring' : 'one_time' %>">
            Buy<%= pTwo.name ? ` ${pTwo.name}` : '' %>
          </button>
        </div>
        <% } %>
      </div>

      <div class="user-profile">
        <h2>Purchase History</h2>
        <% if ((billing?.purchases || []).length === 0) { %>
          <p>No purchases yet.</p>
        <% } else { %>
          <table class="table">
            <thead><tr><th>Date</th><th>Product</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
            <% billing.purchases.forEach(p => { %>
              <tr>
                <td><%= new Date(p.created_at).toLocaleString() %></td>
                <td><%= p.product_key %></td>
                <td><%= (p.amount/100).toFixed(2) %> <%= p.currency.toUpperCase() %></td>
                <td><%= p.status %></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('partials/modals') %>
  <script src="/js/supabase-client.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/sbClient.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/nav-client.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/logout.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/modalManager.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/pay.js?v=<%= page.assetVersion || Date.now() %>" nonce="<%= page.nonce %>"></script>
  <script nonce="<%= page.nonce %>">
    // Tiny toast for return from Checkout with receipt link and retry logic
    (async function(){
      const qs = new URLSearchParams(location.search);
      const sessionId = qs.get('session_id');
      
      if (qs.get('paid') === '1') {
        // Retry function to handle receipt URL timing issues
        async function fetchReceiptWithRetry(id) {
          const delays = [300, 600, 1200, 2000, 3000]; // total ~7s max
          for (let i = 0; i < delays.length; i++) {
            try {
              const res = await fetch(`/api/pay/receipt?session_id=${encodeURIComponent(id)}`, { 
                credentials: 'include' 
              });
              
              if (res.status === 200) {
                const data = await res.json().catch(() => ({}));
                if (data?.ok && data.receipt_url) {
                  return data.receipt_url;
                }
              }
            } catch (e) {
              // Silent fail, continue to next retry
            }
            
            if (i < delays.length - 1) {
              await new Promise(r => setTimeout(r, delays[i]));
            }
          }
          return null;
        }

        let message = { text: 'Thanks! Your purchase has been recorded.' };
        
        if (sessionId) {
          const url = await fetchReceiptWithRetry(sessionId);
          if (url) {
            message = { text: 'Thanks!', linkHref: url, linkText: 'View receipt' };
          }
        }
        
        window.modalManager?.showNotification('Payment received', message);
        history.replaceState(null,'',location.pathname); // clean URL
      } else if (qs.get('canceled') === '1') {
        window.modalManager?.showNotification('Payment canceled','No charge was made.');
        history.replaceState(null,'',location.pathname);
      }
    })();
  </script>
</body>
</html>
