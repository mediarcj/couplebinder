<!-- File: server/ejs/index.ejs
     Description: Main homepage template for application
     Purpose: Displays the main page with application overview and feature information
     Notes: Uses EJS templating with server-provided configuration values, follows Master Protected Template Constitution -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <meta id="app-config" 
          data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
          data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
    <title><%= page.title %></title>
    <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || Date.now() %>">
    <script src="/js/supabase-client.js" nonce="<%= page.nonce %>"></script>
    <script src="/js/sbClient.js" nonce="<%= page.nonce %>"></script>
    <script src="/js/logout.js" nonce="<%= page.nonce %>"></script>
    <script src="/js/modalManager.js" nonce="<%= page.nonce %>"></script>
    <script src="/js/nav-client.js" nonce="<%= page.nonce %>"></script>
    
    <!-- Cross-tab logout synchronization -->
    <script nonce="<%= page.nonce %>">
        /**
         * Cross-tab logout synchronization
         * 
         * WHAT:
         * We listen for logout events from other tabs and instantly sync the UI.
         *
         * WHY:
         * When a user logs out in one tab, all other tabs should immediately show
         * the logged-out state for consistent UX.
         *
         * HOW:
         * Uses BroadcastChannel to communicate between tabs and redirects to homepage
         * when logout is detected from another tab.
         */
        try {
            const bc = new BroadcastChannel('auth');
            
            // Listen for logout events from other tabs
            bc.onmessage = (e) => {
                if (e?.data?.type === 'LOGOUT') {
                    // Drop any local UI state and hard-redirect to homepage
                    window.location.replace('/');
                }
            };
            
            // Clean up when page unloads
            window.addEventListener('beforeunload', () => {
                try { bc.close(); } catch {}
            });
        } catch (error) {
            // BroadcastChannel not supported - continue without cross-tab sync
            console.warn('Cross-tab logout sync not available');
        }
    </script>
</head>
<body data-auth-hydrate="true">
    <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>

    <main>
        <div class="container">
            <!-- ============================================================
            SECTION: HERO HEADER
            ============================================================ -->
            <div class="hero">
                <h1>Welcome to <%= app_info?.name || 'Application' %></h1>
                <p class="subtitle"><%= page.description %></p>
            </div>

            <!-- ============================================================
            SECTION: MAIN CONTENT (Master Template Style)
            ============================================================ -->
            <div class="dashboard-actions">
                <h2>About <%= app_info?.name || 'Application' %></h2>
                <p class="subtitle text-center text-muted">
                    A modern, secure web application built with defense-in-depth security.
                </p>

                <div class="text-submission">
                    <h3>Overview</h3>
                    <p>
                        <%= app_info?.name || 'Application' %> is built with security-first principles,
                        featuring comprehensive middleware protection, nonce-based CSP, CSRF protection,
                        and server-authoritative validation.
                    </p>
                    <p>
                        All user actions are validated server-side. The frontend follows backend instructions
                        to ensure consistent security and user experience.
                    </p>

                    <div class="features">
                        <div class="feature-grid">
                            <div class="feature-card">
                                <h3>Secure by Design</h3>
                                <p>
                                    Built with strong security middleware including Helmet, CORS, rate limiting,
                                    and progressive lockouts. Defense-in-depth architecture protects at every layer.
                                </p>
                            </div>
                            <div class="feature-card">
                                <h3>Clean Code</h3>
                                <p>
                                    Built with simple and reliable code following the Detechify Building Laws.
                                    Plain English documentation and modular architecture.
                                </p>
                            </div>
                            <div class="feature-card">
                                <h3>EJS Frontend</h3>
                                <p>
                                    Starting with EJS templates, ready for future Next.js migration when needed.
                                    Presenter pattern separates business logic from templates.
                                </p>
                            </div>
                        </div>
                    </div>

                    <p class="text-muted mt-one">
                        All pages follow the Master Protected Template Constitution for consistent security
                        and user experience across the application.
                    </p>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <!-- Centralized Modals (login, signup, notifications) -->
    <%- include('partials/modals') %>

    <script src="/js/main.js?v=<%= page.assetVersion || Date.now() %>" nonce="<%= page.nonce %>"></script>
</body>
</html>
