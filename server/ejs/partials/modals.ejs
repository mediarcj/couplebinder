<!-- File: server/ejs/partials/modals.ejs -->
<!-- Description: Centralized modal templates for all pages -->
<!-- Purpose: Single source of truth for password change confirmation and notification modals -->
<!-- Notes: Enforces consistent CSRF, input limits, and CSP-compliant styling -->

<!-- 
  WHAT:
  Provides reusable modal templates that work on any page.
  
  WHY:
  Security: One place to enforce CSRF tokens, input sanitization, and CSP.
  Consistency: Same UX and error handling everywhere.
  Maintenance: Fix once, applies to all pages.
  
  HOW:
  Include this partial in any page that needs modals.
  Use the centralized modalManager.js to control behavior.
-->

<!-- ============================================================ -->
<!-- Password Change Confirmation Modal -->
<!-- ============================================================ -->
<div id="passwordChangeConfirmModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="passwordChangeConfirmTitle">Confirm Password Change</h2>
            <span class="close" data-modal-close="passwordChangeConfirmModal">&times;</span>
        </div>
        <div class="modal-body">
            <!-- Confirmation State -->
            <div id="passwordChangeConfirmState" class="modal-state">
                <p id="passwordChangeConfirmMessage">You will be logged out once your new password is set.</p>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" id="passwordChangeCancelBtn">Cancel</button>
                    <button type="button" class="btn btn-primary" id="passwordChangeResetBtn">Reset Password</button>
                </div>
            </div>
            
            <!-- Cancelled State -->
            <div id="passwordChangeCancelledState" class="modal-state hidden">
                <p id="passwordChangeCancelledMessage">Your request to update password was cancelled. No changes were made.</p>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" id="passwordChangeCancelledOkBtn">OK</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- Notification Modal (Generic) -->
<!-- ============================================================ -->
<div id="notificationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="notificationTitle">Notification</h2>
            <span class="close" data-modal-close="notificationModal">&times;</span>
        </div>
        <div class="modal-body">
            <p id="notificationMessage">Message goes here</p>
            <div class="form-actions">
                <button type="button" class="btn btn-primary" id="notificationOkBtn">OK</button>
            </div>
        </div>
    </div>
</div>

