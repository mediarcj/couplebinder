# server + app
NODE_ENV=test
PUBLIC_ORIGIN=http://localhost:3000
APP_NAME=Detechify (Test)

# auth (use inert values; tests won't hit real Supabase)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=test_anon_key
SUPABASE_JWKS='{"keys":[{"kty":"oct","k":"dGVzdF9zZWNyZXQ"}]}'

# redis
REDIS_URL=redis://localhost:6379
FIREWALL_FAIL_CLOSED=true
# Optional: run without Redis by exporting a null client (see step 3)
REDIS_TEST_MODE=memory

# security knobs
CSRF_SECRET=test_csrf_secret
JWT_ALLOWED_ALGS=HS256,RS256,ES256