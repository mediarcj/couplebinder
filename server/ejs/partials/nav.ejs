<!-- File: server/ejs/partials/nav.ejs -->
<!-- Description: Shared navigation component for all pages -->
<!-- Purpose: Single navigation implementation for consistency -->
<!-- Notes: CSP-compliant; uses original header structure for CSS compatibility -->

<%
// Expected: nav = { items: [...], csrfToken }, app_info = { name, description, ... }
// Each item has: id, label, type ('link' or 'action'), href, action, method, csrf, active
const appName = typeof app_info !== 'undefined' ? app_info?.name : 'Detechify';
%>
<header>
  <nav role="navigation" aria-label="Primary">
    <div class="container">
      <h1><%= appName %></h1>
      <div class="nav-content">
        <ul>
          <% nav.items.forEach((it) => { %>
            <% if (it.type === 'link') { %>
              <li>
                <a href="<%= it.href %>" <% if (it.modal) { %> data-modal-open="<%= it.modal %>" role="button" <% } %>><%= it.label %></a>
              </li>
            <% } else if (it.type === 'action') { %>
              <li>
                <form action="<%= it.action %>" method="POST" class="nav-form">
                  <% if (it.csrf && nav.csrfToken) { %>
                    <input type="hidden" name="_csrf" value="<%= nav.csrfToken %>">
                  <% } %>
                  <button 
                    type="submit"
                    <% if (it.data && it.data.logout) { %> data-logout="true" <% } %>
                  ><%= it.label %></button>
                </form>
              </li>
            <% } else { %>
              <li class="nav-text" aria-live="polite"><span><%= it.label %></span></li>
              <!-- ADD-NEW-HERE: turn on this nav item when ready -->
              <!-- <li><a href="/dashboard/template-protected">Template Example</a></li> -->
              
            <% } %>
          <% }) %>
        </ul>
      </div>
    </div>
  </nav>
</header>
