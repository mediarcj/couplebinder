<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
  <% if (typeof APP_CONFIG !== 'undefined') { %>
    <meta id="app-config" 
          data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
          data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
  <% } %>
  <title><%= page?.title || 'Billing – ' + (app_info?.name || 'Application') %></title>
  <link rel="icon" href="/images/favicon.ico">
  <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">
</head>
<body data-auth-hydrate="true">
  <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>

  <main>
    <div class="container">
      <div class="hero">
        <h1>Billing</h1>
        <p class="subtitle">Secure payments are powered by Stripe. We never store card numbers.</p>
      </div>

      <div class="action-grid">
        <%
          // Prefer LIVE then TEST then legacy; match whichever exists in billing.pricing
          const candOne = [env?.STRIPE_PRICE_RESUME_ONE_TIME_LIVE, env?.STRIPE_PRICE_RESUME_ONE_TIME_TEST, env?.STRIPE_PRICE_RESUME_ONE_TIME].filter(Boolean);
          const candTwo = [env?.STRIPE_PRICE_RESUME_EXPERT_LIVE,  env?.STRIPE_PRICE_RESUME_EXPERT_TEST,  env?.STRIPE_PRICE_RESUME_EXPERT].filter(Boolean);
          const pOne = (billing?.pricing || []).find(p => candOne.includes(p.priceId));
          const pTwo = (billing?.pricing || []).find(p => candTwo.includes(p.priceId));
        %>

        <% if (pOne) { %>
        <div class="action-card">
          <% if (pOne.image) { %>
            <img class="product-img" src="<%= pOne.image %>" alt="<%= pOne.name || '' %>" loading="lazy" decoding="async">
          <% } %>
          <% if (pOne.name) { %><h3><%= pOne.name %></h3><% } %>
          <% if (pOne.description) { %><p><%= pOne.description %></p><% } %>
          <% if (Number.isFinite(pOne.unit_amount)) { %>
          <p class="price">
            $<%= (pOne.unit_amount / 100).toFixed(0) %> <%= (pOne.currency || '').toUpperCase() %>
            <%= pOne.isRecurring ? `/${pOne.interval}` : ' one-time' %>
          </p>
          <% } %>
          <a class="btn btn-primary btn-block" id="buyResumeBasic"
             href="/dashboard/checkout/review?product=resume_one_time&qty=1">
            Buy<%= pOne.name ? ` ${pOne.name}` : '' %>
          </a>
        </div>
        <% } %>

        <% if (pTwo) { %>
        <div class="action-card">
          <% if (pTwo.image) { %>
            <img class="product-img" src="<%= pTwo.image %>" alt="<%= pTwo.name || '' %>" loading="lazy" decoding="async">
          <% } %>
          <% if (pTwo.name) { %><h3><%= pTwo.name %></h3><% } %>
          <% if (pTwo.description) { %><p><%= pTwo.description %></p><% } %>
          <% if (Number.isFinite(pTwo.unit_amount)) { %>
          <p class="price">
            $<%= (pTwo.unit_amount / 100).toFixed(0) %> <%= (pTwo.currency || '').toUpperCase() %>
            <%= pTwo.isRecurring ? `/${pTwo.interval}` : ' one-time' %>
          </p>
          <% } %>
          <a class="btn btn-primary btn-block" id="buyResumeExpert"
             href="/dashboard/checkout/review?product=resume_expert&qty=1">
            Buy<%= pTwo.name ? ` ${pTwo.name}` : '' %>
          </a>
        </div>
        <% } %>
      </div>

      <!-- Purchase History removed by request -->
    </div>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
    </div>
  </footer>

  <%- include('partials/modals') %>

  <!-- Shared core scripts -->
  <script src="/js/supabase-client.js?v=<%= page.assetVersion || assetVersion || '' %>"></script>
  <script src="/js/sbClient.js?v=<%= page.assetVersion || assetVersion || '' %>"></script>
  <script src="/js/logout.js?v=<%= page.assetVersion || assetVersion || '' %>"></script>
  <script src="/js/modalManager.js?v=<%= page.assetVersion || assetVersion || '' %>"></script>
  <script src="/js/nav-client.js?v=<%= page.assetVersion || assetVersion || '' %>"></script>
  
  <!-- Page-specific scripts -->
  <script src="/js/pay.js?v=<%= page.assetVersion || assetVersion || '' %>"></script>
  <script src="/js/main.js?v=<%= page.assetVersion || assetVersion || '' %>"></script>
</body>
</html>