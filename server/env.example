# Detechify Server Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration (Supabase PostgreSQL)
# Note: Use SUPABASE_DB_URL instead of individual DB_* variables
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=paicon
# DB_USER=novy
# DB_PASSWORD=your-database-password

# Security Configuration
SESSION_SECRET=your-session-secret-here

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=50

# Input Validation Limits
TEXT_MIN_LENGTH=20
TEXT_MAX_LENGTH=5000
MAX_SUBMISSIONS=10

# External Services (prepared for future use)
# STRIPE_SECRET_KEY=
# JWT_SECRET=
# BCRYPT_ROUNDS=

# Supabase Configuration (Required for stateless authentication)
# NOTE: Do not commit real secrets. Copy these to your local .env only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-ref.supabase.co:5432/postgres
