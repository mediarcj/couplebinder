{
  "name": "application-server",
  "version": "1.0.0",
  "description": "Application server",
  "main": "zorvalon.js",
  "scripts": {
    "start": "node zorvalon.js",
    "dev": "node zorvalon.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "lint": "eslint --max-warnings=0 .",
