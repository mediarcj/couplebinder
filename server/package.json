    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^4.22.2",
    "helmet": "^7.1.0",
    "jose": "^6.2.4",
    "micromatch": "^4.0.8",
    "multer": "^2.2.0",
    "pdfkit": "^0.17.2",
    "rate-limiter-flexible": "^5.0.3",
    "redis": "4.6.14",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
