# Detechify Server Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=detechify
DB_USER=postgres
DB_PASSWORD=

# Security Configuration (prepared for future use)
# JWT_SECRET=
# SESSION_SECRET=
# BCRYPT_ROUNDS=12

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Input Validation Limits
TEXT_MIN_LENGTH=20
TEXT_MAX_LENGTH=5000
MAX_SUBMISSIONS=10

# External Services (prepared for future use)
# REDIS_URL=
# STRIPE_SECRET_KEY=
