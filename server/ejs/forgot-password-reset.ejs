<!-- File: server/ejs/forgot-password-reset.ejs
     Description: Password reset confirmation page -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <% if (typeof APP_CONFIG !== 'undefined') { %>
      <meta id="app-config" 
            data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
            data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
    <% } %>
    <title>Reset Password - <%= app_info?.name || 'Application' %></title>
    <link rel="icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">
</head>
<body data-auth-hydrate="false">
    <%- include('partials/nav', { nav: page.nav, app_info }) %>

    <main class="auth-page">
        <div class="auth-card">
            <div class="auth-icon" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" role="img">
                    <path fill="#4F46E5" d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2Zm-6 7.73V17a1 1 0 0 0 2 0v-1.27a1.75 1.75 0 1 0-2 0ZM15 8H9V6a3 3 0 0 1 6 0Z"/>
                </svg>
            </div>
            <h1>Create a new password</h1>
            <p class="auth-subtitle">Use the form below to finish resetting your password.</p>

            <div class="recovery-message" data-recovery-message>
                <p>We could not detect a recovery link. Open the reset link from your email on this device to continue.</p>
            </div>

            <form method="post" action="/auth/forgot-password" class="forgot-form hidden" data-recovery-form>
                <input type="hidden" name="_csrf" value="<%= ui.csrfToken || '' %>">
                <input type="hidden" id="recoveryAccessToken" name="access_token">
                <label for="resetNewPassword">New password</label>
                <input id="resetNewPassword" name="new_password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required placeholder="Minimum 8 characters">
                <label for="resetConfirmPassword">Re-enter new password</label>
                <input id="resetConfirmPassword" name="confirm_password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required placeholder="Re-enter your password">
                <div class="form-actions">
                    <a href="/" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update password</button>
                </div>
            </form>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <%- include('partials/modals') %>

    <!-- Shared core scripts -->
    <script src="/js/supabase-client.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/sbClient.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/logout.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/modalManager.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/nav-client.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    
    <!-- Page-specific scripts -->
    <script src="/js/forgot-password-reset.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/main.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
</body>
</html>

