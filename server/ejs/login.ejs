<!-- File: server/ejs/login.ejs
     Description: Dedicated login page -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <% if (typeof APP_CONFIG !== 'undefined') { %>
      <meta id="app-config" 
            data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
            data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
    <% } %>
    <title>Log in - <%= app_info?.name || 'Application' %></title>
    <link rel="icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">
    <% if (ui?.turnstile?.enabled && ui?.turnstile?.siteKey) { %>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>
</head>
<body data-auth-hydrate="false">
    <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>
    
    <main class="auth-page">
        <div class="auth-card login-card">
            <h1 class="login-title">Log in</h1>

            <form
                id="loginForm"
                method="post"
                action="/auth/login"
                class="login-form"
                data-turnstile-enabled="<%= ui?.turnstile?.enabled ? 'true' : 'false' %>">
                <input type="hidden" name="_csrf" value="<%= ui.csrfToken || '' %>">

                <div id="loginStep1" class="login-step login-step--primary">
                    <div class="form-group login-email-group">
                        <input 
                            type="email" 
                            id="loginEmail" 
                            name="email" 
                            placeholder="Email"
                            maxlength="<%= ui_instructions?.input_limits?.email_max || 100 %>"
                            autocomplete="email"
                            required
                            class="login-input"
                        >
                        <div id="emailError" class="error-message"></div>
                    </div>

                    <div
                        id="loginContinueRow"
                        class="form-actions login-actions login-actions--continue">
                        <button
                            type="button"
                            id="loginContinueBtn"
                            class="btn btn-primary btn-login-continue btn-full">
                            Continue
                        </button>
                    </div>

                    <!-- Step 1 footer (will be hidden when Step 2 is active) -->
                    <div id="loginFooterStep1" class="login-footer">
                        <p class="login-register-text">
                            Don't have an account? <a href="/register" class="login-register-link">Register</a>
                        </p>
                    </div>                    
                </div>

                <div id="loginStep2" class="login-step login-step--secondary hidden">
                    <div class="form-group">
                        <div class="password-input-wrapper">
                            <input 
                                type="password" 
                                id="loginPassword" 
                                name="password" 
                                placeholder="Password"
                                autocomplete="current-password"
                                required
                                class="login-input password-input"
                            >
                            <button
                                type="button"
                                class="password-toggle"
                                data-target="loginPassword"
                                aria-label="Show password"
                                aria-pressed="false">
                                <svg
                                    class="password-toggle-icon"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true">
                                    <path
                                        d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12z"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.8"
                                        stroke-linecap="round"
                                        stroke-linejoin="round" />
                                    <circle
                                        cx="12"
                                        cy="12"
                                        r="3"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.8" />
                                </svg>
                            </button>
                        </div>
                        <div id="passwordError" class="error-message"></div>
                    </div>

                    <div
                      id="loginMessageContainer"
                      class="form-group login-message-row <%= (page.passwordChangedSuccess || page.registerSuccess) ? '' : 'hidden' %>">
                      <div
                        id="loginGeneralMessage"
                        class="login-message <%= (page.passwordChangedSuccess || page.registerSuccess) ? 'login-message--success' : 'hidden' %>"
                        role="alert">
                        <% if (page.passwordChangedSuccess) { %>
                          Your password has been changed successfully. Please use your new password to log in.
                        <% } else if (page.registerSuccess) { %>
                          Your account has been created. Please log in to continue.
                        <% } %>
                      </div>
                    </div>

                    <% if (ui?.turnstile?.enabled && ui?.turnstile?.siteKey) { %>
                      <div class="form-group turnstile-check">
                        <div
                          class="cf-turnstile"
                          data-sitekey="<%= ui.turnstile.siteKey %>"
                          data-action="login"
                          data-theme="light"
                          data-size="flexible">
                        </div>
                      </div>
                    <% } %>

                    <div class="form-actions login-actions">
                        <button type="submit" class="btn btn-primary btn-login">Log in</button>
                    </div>

                    <div class="login-footer">
                        <p class="login-register-text">
                            Don't have an account? <a href="/register" class="login-register-link">Register</a>
                        </p>
                        <a href="/forgot-password" class="login-forgot-link">Forgot Password?</a>
                    </div>
                </div>

            </form>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <%- include('partials/modals') %>

    <!-- Shared core scripts -->
    <script src="/js/supabase-client.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/sbClient.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/logout.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/modalManager.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/nav-client.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    
    <!-- Page-specific scripts -->
    <script src="/js/login.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/main.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
</body>
</html>

