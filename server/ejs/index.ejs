<!-- File: server/ejs/index.ejs
     Description: Main homepage template for Detechify
     Purpose: Displays the main page with text submission form and recent submissions
     Notes: Uses EJS templating with server-provided configuration values -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <title><%= page.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
    <header>
        <nav>
            <div class="container">
                <h1>Detechify</h1>
                <div class="nav-content">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/health">Health</a></li>
                        <li><a href="/api/hello">API</a></li>
                    </ul>
                    <div class="auth-section">
                        <% if (user.isAuthenticated) { %>
                            <a href="/dashboard" class="dashboard-link">Dashboard</a>
                            <a href="#" class="logout-link">Logout</a>
                        <% } else { %>
                            <a href="#" class="login-link">Login</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <div class="hero">
                <h1>Welcome to Detechify</h1>
                <p class="subtitle"><%= page.description %></p>
                <div class="cta-buttons">
                    <a href="/health" class="btn btn-primary">Check Health</a>
                    <a href="/api/hello" class="btn btn-primary">API Test</a>
                </div>
            </div>

            <div class="text-submission">
                <h2>Text Submission Demo</h2>
                <p>Enter text below to test backend validation:</p>
                <form id="textForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group">
                        <textarea 
                            id="textInput" 
                            name="text" 
                            placeholder="Enter your text here (minimum <%= features.textLimits.min %> characters, maximum <%= features.textLimits.max %> characters)..."
                            rows="4"
                            maxlength="<%= features.textLimits.max %>"
                        ></textarea>
                        <div class="char-count">
                            <span id="charCount">0</span> / <%= features.textLimits.max %> characters
                        </div>
                    </div>
                    <button type="submit" class="btn btn-secondary">Submit Text</button>
                </form>
                <div id="result" class="result-message"></div>
                <div class="submission-actions">
                    <button id="viewSubmissionsBtn" class="btn btn-secondary">View Recent Submissions</button>
                </div>
                <div id="submissionsList" class="submissions-list"></div>
            </div>

            <div class="features">
                <div class="feature-grid">
                    <div class="feature-card">
                        <h3>Secure by Design</h3>
                        <p>Built with strong security middleware including Helmet, CORS, and rate limiting.</p>
                    </div>
                    <div class="feature-card">
                        <h3>Clean Code</h3>
                        <p>Built with simple and reliable code.</p>
                    </div>
                    <div class="feature-card">
                        <h3>EJS Frontend</h3>
                        <p>Starting with EJS templates, ready for future Next.js migration when needed.</p>
                    </div>
                </div>
            </div>

            <div class="status">
                <h2>Server Status</h2>
                <div class="status-item">
                    <span class="status-label">API Endpoint:</span>
                    <span class="status-value">Active</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Security Middleware:</span>
                    <span class="status-value">Enabled</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Rate Limiting:</span>
                    <span class="status-value">100 req/15min</span>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 Detechify. Building the future of tech detection.</p>
        </div>
    </footer>

    <!-- Login Modal -->
    <div id="loginModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Login to Detechify</h2>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <!-- Login Form State -->
                <div id="loginFormState" class="modal-state">
                    <form id="loginForm">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group">
                            <label for="loginEmail">Email Address</label>
                            <input 
                                type="text" 
                                id="loginEmail" 
                                name="email" 
                                placeholder="Enter your email address"
                                maxlength="<%= ui_instructions.input_limits.email_max || 40 %>"
                                autocomplete="email"
                            >
                            <div id="emailError" class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label for="loginPassword">Password</label>
                            <input 
                                type="password" 
                                id="loginPassword" 
                                name="password" 
                                placeholder="Enter your password"
                                autocomplete="current-password"
                            >
                            <div id="passwordError" class="error-message"></div>
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary">Cancel</button>
                            <button type="submit" class="btn btn-secondary">Login</button>
                        </div>
                        <div id="loginGeneralError" class="error-message" style="display: none;"></div>
                    </form>
                </div>
                
                <!-- Login Success State -->
                <div id="loginSuccessState" class="modal-state" style="display: none;">
                    <div class="success-content">
                        <div class="success-icon">OK</div>
                        <h3 id="successTitle">Login Successful!</h3>
                        <p id="successMessage">Welcome message</p>
                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary" id="successOkBtn">OK</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Modal -->
    <div id="notificationModal" class="modal">
        <div class="modal-content notification-modal">
            <div class="modal-header">
                <h2 id="notificationTitle">Notification</h2>
                <span class="close" id="notificationClose">&times;</span>
            </div>
            <div class="modal-body">
                <p id="notificationMessage">Message content</p>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" id="notificationOkBtn">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pass server config to client-side JavaScript via data attributes -->
    <div id="app-config" 
         data-text-min-length="<%= features.textLimits.min %>" 
         data-text-max-length="<%= features.textLimits.max %>"
         data-supabase-url="<%= process.env.SUPABASE_URL %>"
         data-supabase-anon-key="<%= process.env.SUPABASE_ANON_KEY %>"
         style="display: none;"></div>
    <script src="/js/main.js" nonce="<%= page.nonce %>"></script>
</body>
</html>
