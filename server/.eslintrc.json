{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "error",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["zorvalon.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["utils/consoleLogger.js", "utils/logger.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/__tests__/**/*.js", "**/*.test.js", "**/*.spec.js"],
      "rules": {
        "no-console": "off",
        "no-undef": "off"
      }
    },
    {
      "files": ["public/**/*.js"],
      "env": {
        "browser": true
      },
      "rules": {
        "no-console": "warn"
      }
    },
    {
      "files": ["middleware/authBridge.js", "middleware/corsDebug.js"],
      "rules": {
        "no-console": "warn"
      }
    }
  ]
}

