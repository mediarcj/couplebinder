// File: package.json
// Description: Root workspace configuration for Detechify project
// Purpose: Manages npm workspaces and shared scripts for server and future NextJS frontend
// Notes: Contains Docker scripts and workspace definitions

{
  "name": "detechify",
  "version": "1.0.0",
  "description": "A web application project",
  "private": true,
  "workspaces": [
    "server",
    "nextjs"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "dev": "npm run dev --workspace=server",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediarcj/detechify.git"
  },
  "bugs": {
    "url": "https://github.com/mediarcj/detechify/issues"
  },
  "homepage": "https://github.com/mediarcj/detechify#readme"
}