<!-- File: server/ejs/register.ejs
     Description: Dedicated registration page -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <% if (typeof APP_CONFIG !== 'undefined') { %>
      <meta id="app-config" 
            data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
            data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
    <% } %>
    <title>Register - <%= app_info?.name || 'Application' %></title>
    <link rel="icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">
    <% if (ui?.turnstile?.enabled && ui?.turnstile?.siteKey) { %>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>
</head>
<body data-auth-hydrate="false">
    <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>
    
    <main class="auth-page">
        <div class="auth-card register-card">
            <h1 class="register-title">Create your account</h1>

            <form
                id="registerForm"
                method="post"
                class="register-form"
                data-turnstile-enabled="<%= ui?.turnstile?.enabled ? 'true' : 'false' %>">
                <input type="hidden" name="_csrf" value="<%= ui.csrfToken || '' %>">

                <div class="form-group">
                    <label for="registerDisplayName">Full name</label>
                    <input 
                        type="text" 
                        id="registerDisplayName" 
                        name="display_name" 
                        placeholder="Enter your full name"
                        maxlength="<%= ui_instructions?.input_limits?.name_max || 40 %>"
                        autocomplete="name"
                        required
                        class="register-input"
                    >
                    <div id="registerDisplayNameError" class="error-message"></div>
                </div>
                
                <div class="form-group">
                    <label for="registerEmail">Email address</label>
                    <input 
                        type="email" 
                        id="registerEmail" 
                        name="email" 
                        placeholder="Enter your email address"
                        maxlength="<%= ui_instructions?.input_limits?.email_max || 40 %>"
                        autocomplete="email"
                        required
                        class="register-input"
                    >
                    <div id="registerEmailError" class="error-message"></div>
                </div>

                <div class="form-group">
                    <label for="registerPhone">Phone number (optional)</label>
                    <input 
                        type="tel" 
                        id="registerPhone" 
                        name="phone" 
                        placeholder="Enter your phone number"
                        minlength="8"
                        maxlength="15"
                        pattern="[0-9]+"
                        autocomplete="tel"
                        class="register-input"
                    >
                    <div id="registerPhoneError" class="error-message"></div>
                </div>
                
                <div class="form-group">
                    <label for="registerPassword">Password</label>
                    <input 
                        type="password" 
                        id="registerPassword" 
                        name="password" 
                        placeholder="Min 8 chars, 1 capital, 1 number, no spaces"
                        minlength="<%= ui_instructions?.input_limits?.password_min || 8 %>"
                        maxlength="<%= ui_instructions?.input_limits?.password_max || 40 %>"
                        autocomplete="new-password"
                        required
                        pattern="[a-zA-Z0-9]+"
                        class="register-input"
                    >
                    <div id="registerPasswordError" class="error-message"></div>
                </div>
                
                <div class="form-group">
                    <label for="registerConfirmPassword">Confirm password</label>
                    <input 
                        type="password" 
                        id="registerConfirmPassword" 
                        name="confirm_password" 
                        placeholder="Re-enter your password"
                        minlength="<%= ui_instructions?.input_limits?.password_min || 8 %>"
                        maxlength="<%= ui_instructions?.input_limits?.password_max || 40 %>"
                        autocomplete="new-password"
                        required
                        class="register-input"
                    >
                    <div id="confirmPasswordError" class="error-message"></div>
                </div>

                <div id="registerMessageContainer" class="form-group register-message-row hidden">
                    <div id="registerGeneralMessage" class="register-message hidden" role="alert"></div>
                </div>

                <% if (ui?.turnstile?.enabled && ui?.turnstile?.siteKey) { %>
                  <div class="form-group turnstile-check">
                    <div
                      class="cf-turnstile"
                      data-sitekey="<%= ui.turnstile.siteKey %>"
                      data-action="register"
                      data-theme="light"
                      data-size="flexible">
                    </div>
                  </div>
                <% } %>

                <div class="form-actions register-actions">
                    <button type="submit" class="btn btn-primary btn-register">Create account</button>
                </div>

                <div class="register-footer">
                    <p class="register-login-text">
                        Already have an account? <a href="/login" class="register-login-link">Log in</a>
                    </p>
                </div>
            </form>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <%- include('partials/modals') %>

    <!-- Shared core scripts -->
    <script src="/js/supabase-client.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/sbClient.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/logout.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/modalManager.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/nav-client.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    
    <!-- Page-specific scripts -->
    <script src="/js/register.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
    <script src="/js/main.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
</body>
</html>

