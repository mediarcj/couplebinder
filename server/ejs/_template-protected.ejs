Description: Master protected page template for authenticated users
Purpose: Defines the base structure for any secure page (nonce, CSRF, nav, UI consistency)
Usage: Copy this file, rename it, and connect to a matching route and presenter.
============================================================ -->

<!-- 
// CONNECT: This file belongs to the master protected page system.
// CLONE GUIDE:
// 1. Copy _template-protected.ejs → newpage.ejs
// 2. Copy _templatePresenter.js → newpagePresenter.js
// 3. Add route in dashboard.js → /newpage
// 4. Export new builder in presenters/index.js if needed.
-->

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ============================================================
  SECTION: HEAD / SECURITY META
  ============================================================ -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
  <% if (typeof APP_CONFIG !== 'undefined') { %>
    <meta id="app-config"
          data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>"
          data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
  <% } %>
  <title><%= page?.title || 'Untitled Page' %></title>
  <link rel="icon" href="/images/favicon.ico">
  <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">

  <!-- Inline nonce-safe boot -->
  <script nonce="<%= page.nonce %>">
    try {
      const bc = new BroadcastChannel('auth');
      bc.onmessage = (e) => {
        if (e?.data?.type === 'LOGOUT') window.location.replace('/');
      };
    } catch (err) {
      console.warn('BroadcastChannel unavailable', err);
    }
  </script>
</head>

<body data-auth-hydrate="true">
  <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>

  <main>
