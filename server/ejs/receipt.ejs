<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
  <% if (typeof APP_CONFIG !== 'undefined') { %>
    <meta id="app-config" 
          data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
          data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
  <% } %>
  <title><%= page?.title || app_info?.name || 'Application' %></title>
  <link rel="icon" href="/images/favicon.ico">
  <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">
</head>
<body data-auth-hydrate="true">
  <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>

  <main>
    <div class="container">
      <div class="hero">
        <h1>Receipt</h1>
        <p class="subtitle">Your payment confirmation</p>
      </div>

      <div class="user-profile">
        <h2>Payment Details</h2>
        <div class="profile-card">
          <div class="receipt-toolbar print-hide">
            <div class="qr-wrap" title="Scan to open receipt on another device" aria-label="QR code for this receipt">
              <div class="qr"><%- qrSvg %></div>
              <div class="qr-caption">Scan to view</div>
            </div>
            <div class="toolbar-actions print-hide">
              <button class="btn" data-action="print" type="button">Print / Save PDF</button>
              <a class="btn btn-secondary" href="/dashboard/receipt.pdf?session_id=<%= encodeURIComponent(receipt.session_id || '') %>" target="_blank" rel="noopener">Download PDF</a>
              <% if (features && features.emailReceipt) { %>
                <button class="btn btn-secondary" data-action="email" type="button">Email me this receipt</button>
              <% } %>
            </div>
          </div>

          <div class="profile-info">
            <div class="info-item">
              <span class="info-label">Status:</span>
              <span class="info-value status-value status-<%= receipt.payment_status %>"><%= receipt.payment_status %></span>
            </div>
            <div class="info-item">
              <span class="info-label">Date:</span>
              <span class="info-value"><%= new Date(receipt.created_ms).toLocaleString() %></span>
            </div>
            <div class="info-item">
              <span class="info-label">Customer:</span>
              <span class="info-value"><%= receipt.customer_name || receipt.customer_email || '—' %></span>
            </div>
            <div class="info-item">
              <span class="info-label">Total:</span>
              <span class="info-value"><%= (receipt.amount_total/100).toFixed(2) %> <%= receipt.currency.toUpperCase() %></span>
            </div>
            <% if (receipt.card_brand) { %>
              <div class="info-item">
                <span class="info-label">Card:</span>
                <span class="info-value"><%= receipt.card_brand %> •••• <%= receipt.card_last4 || '—' %></span>
              </div>
            <% } %>
            <% if (receipt.type === 'invoice' && receipt.invoice_number) { %>
              <div class="info-item">
                <span class="info-label">Invoice #:</span>
                <span class="info-value"><%= receipt.invoice_number %></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="user-profile">
        <h2>Items</h2>
        <% if (receipt.items && receipt.items.length > 0) { %>
          <table class="table">
            <thead>
              <tr>
                <th>Description</th>
                <th>Quantity</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              <% receipt.items.forEach(function (item) { %>
                <tr>
                  <td><%= item.description %></td>
                  <td><%= item.quantity %></td>
                  <td><%= (item.amount_total/100).toFixed(2) %> <%= (item.currency || receipt.currency).toUpperCase() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p>No line items available.</p>
        <% } %>
      </div>

      <div class="dashboard-actions">
        <div class="action-grid">
          <%
            const _rawUrl = (receipt.stripe_receipt_url || receipt.official_receipt_url || '').trim();
            const _cleanUrl = _rawUrl.replace(/^["']+|["']+$/g, '');
            const _ok = /^https?:\/\//i.test(_cleanUrl);
          %>
          <% if (_ok) { %>
            <a href="<%= _cleanUrl %>" class="btn btn-primary" rel="noopener noreferrer" target="_blank">View official Stripe receipt</a>
          <% } %>
          <a href="/dashboard/billing" class="btn btn-secondary">Back to Billing</a>
          <a href="/dashboard" class="btn btn-secondary">Home</a>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
    </div>
  </footer>

  <%- include('partials/modals') %>

  <script src="/js/modalManager.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
  <script nonce="<%= page.nonce %>">
    (function () {
      const btn = document.querySelector('[data-action="print"]');
      if (btn) btn.addEventListener('click', function () { window.print(); });

      const emailBtn = document.querySelector('[data-action="email"]');
      if (emailBtn) {
        emailBtn.addEventListener('click', async function () {
          if (emailBtn.disabled) return;
          emailBtn.disabled = true;
          const sessionId = "<%= (receipt.session_id || '') %>";
          try {
            const res = await fetch('/api/receipt/email', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ session_id: sessionId })
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to queue email');
            window.modalManager?.showNotification('Email sent', 'We\'ll email your receipt shortly.');
          } catch (err) {
            window.modalManager?.showNotification('Error', 'Could not send email. Please try again.');
          } finally {
            emailBtn.disabled = false;
          }
        });
      }
    })();
  </script>
  <script src="/js/main.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
</body>
</html>