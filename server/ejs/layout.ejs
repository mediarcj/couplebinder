<!-- File: server/ejs/layout.ejs
     Description: Base layout template for Detechify pages
     Purpose: Provides common HTML structure with header, navigation, and footer
     Notes: Contains reusable layout elements for consistent page structure -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Detechify</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav>
            <div class="container">
                <h1>Detechify</h1>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/health">Health</a></li>
                    <li><a href="/api/hello">API</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <%- body %>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 Detechify. Building the future of tech detection.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
