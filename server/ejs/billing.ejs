<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
  <meta id="app-config" data-supabase-url="<%= ui.supabaseUrl %>" data-supabase-anon-key="<%= ui.supabaseAnonKey %>">
  <title>Billing – <%= app_info?.name || 'Detechify' %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || Date.now() %>">
</head>
<body>
  <header>
    <nav>
      <div class="container">
        <h1><%= app_info?.name || 'Detechify' %></h1>
        <div class="nav-content">
          <ul>
            <li><a href="/dashboard">Dashboard</a></li>
            <li><a href="/dashboard/billing" class="active">Billing</a></li>
          </ul>
          <div class="auth-section">
            <span class="user-info">Hi, <%= user.display_name %></span>
            <a href="/dashboard/profile-edit" class="btn btn-secondary">Edit Profile</a>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <div class="container">
      <div class="hero">
        <h1>Billing</h1>
        <p class="subtitle">Secure payments are powered by Stripe. We never store card numbers.</p>
      </div>

      <div class="action-grid">
        <% 
          const pOne = (billing?.pricing || []).find(p => p.priceId === env?.STRIPE_PRICE_RESUME_ONE_TIME);
          const pTwo = (billing?.pricing || []).find(p => p.priceId === env?.STRIPE_PRICE_RESUME_EXPERT);
        %>
        <div class="action-card">
          <h3><%= pOne?.name || 'Resume Pro' %></h3>
          <p><%= pOne?.blurb || 'Instant one-time unlock for your generated resume. Ideal for quick polish.' %></p>
          <p class="price">
            $<%= ((pOne?.unit_amount ?? 900) / 100).toFixed(0) %> <%= (pOne?.currency || 'usd').toUpperCase() %>
            <%= pOne?.isRecurring ? `/${pOne.interval}` : ' one-time' %>
          </p>
          <button class="btn btn-primary" 
                  id="buyResumeBasic"
                  data-price-id="<%= pOne?.priceId %>"
                  data-price-type="<%= pOne?.isRecurring ? 'recurring' : 'one_time' %>">
            Buy <%= pOne?.name || 'Resume Pro' %>
          </button>
        </div>

        <div class="action-card">
          <h3><%= pTwo?.name || 'Resume Expert Revamp' %></h3>
          <p><%= pTwo?.blurb || "Deep revision by Detechify's expert pass with premium formatting." %></p>
          <p class="price">
            $<%= ((pTwo?.unit_amount ?? 4900) / 100).toFixed(0) %> <%= (pTwo?.currency || 'usd').toUpperCase() %>
            <%= pTwo?.isRecurring ? `/${pTwo.interval}` : ' one-time' %>
          </p>
          <button class="btn btn-secondary" 
                  id="buyResumeExpert"
                  data-price-id="<%= pTwo?.priceId %>"
                  data-price-type="<%= pTwo?.isRecurring ? 'recurring' : 'one_time' %>">
            Buy <%= pTwo?.name || 'Expert Revamp' %>
          </button>
        </div>
      </div>

      <div class="user-profile">
        <h2>Purchase History</h2>
        <% if ((billing?.purchases || []).length === 0) { %>
          <p>No purchases yet.</p>
        <% } else { %>
          <table class="table">
            <thead><tr><th>Date</th><th>Product</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
            <% billing.purchases.forEach(p => { %>
              <tr>
                <td><%= new Date(p.created_at).toLocaleString() %></td>
                <td><%= p.product_key %></td>
                <td><%= (p.amount/100).toFixed(2) %> <%= p.currency.toUpperCase() %></td>
                <td><%= p.status %></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('partials/modals') %>
  <script src="/js/supabase-client.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/sbClient.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/logout.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/modalManager.js" nonce="<%= page.nonce %>"></script>
  <script src="/js/pay.js?v=<%= page.assetVersion || Date.now() %>" nonce="<%= page.nonce %>"></script>
  <script nonce="<%= page.nonce %>">
    // Tiny toast for return from Checkout with receipt link
    (async function(){
      const qs = new URLSearchParams(location.search);
      const sessionId = qs.get('session_id');
      
      if (qs.get('paid') === '1') {
        // Try to fetch receipt URL
        let message = 'Thanks! Your purchase has been recorded.';
        let receiptUrl = null;
        
        if (sessionId) {
          try {
            const res = await fetch(`/api/pay/receipt?session_id=${encodeURIComponent(sessionId)}`, { 
              credentials: 'include' 
            });
            
            if (res.ok) {
              const data = await res.json().catch(() => ({}));
              if (data?.ok && data.receipt_url) {
                receiptUrl = data.receipt_url;
                message = 'Thanks! <a href="' + receiptUrl + '" target="_blank" rel="noopener">View receipt</a>';
              }
            }
          } catch (e) {
            // Silent fail - still show success message
          }
        }
        
        window.modalManager?.showNotification('Payment received', message);
        history.replaceState(null,'',location.pathname); // clean URL
      } else if (qs.get('canceled') === '1') {
        window.modalManager?.showNotification('Payment canceled','No charge was made.');
        history.replaceState(null,'',location.pathname);
      }
    })();
  </script>
</body>
</html>
