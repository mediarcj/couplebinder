<!-- File: server/ejs/layout.ejs
     Description: Base layout template for application pages
     Purpose: Provides common HTML structure with header, navigation, and footer
     Notes: Contains reusable layout elements for consistent page structure -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui?.csrfToken || '' %>">
    <title><%= title %> - <%= app_info?.name || 'Application' %></title>
    <link rel="icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/css/style.css?v=<%= page?.assetVersion || assetVersion || '' %>">
</head>
<body>
    <header>
        <nav>
            <div class="container">
                <h1><%= app_info?.name || 'Application' %></h1>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/api/hello">API</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <%- body %>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <script src="/js/main.js?v=<%= page?.assetVersion || assetVersion || '' %>" nonce="<%= page?.nonce || '' %>"></script>
</body>
</html>
