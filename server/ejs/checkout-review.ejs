<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
  <% if (typeof APP_CONFIG !== 'undefined') { %>
    <meta id="app-config" 
          data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
          data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
  <% } %>
  <title><%= page?.title || app_info?.name || 'Application' %></title>
  <link rel="icon" href="/images/favicon.ico">
  <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">
</head>
<body data-auth-hydrate="true">
  <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>

  <main>
    <div class="container">
      <div class="hero">
        <h1>Review & Continue</h1>
        <p class="subtitle">Review your order and proceed to secure payment</p>
      </div>

      <div class="checkout-card">
        <div class="checkout-grid">
          <!-- Left column: Order summary -->
          <aside class="summary-col" aria-labelledby="order-summary-title">
            <h3 id="order-summary-title" class="order-summary__title">Order summary</h3>
            <dl class="order-summary__list">
              <div class="row">
                <dt>Product</dt>
                <dd><%= product.name || productKey %></dd>
              </div>
              <div class="row">
                <dt>Quantity</dt>
                <dd><%= quantity %></dd>
              </div>
              <div class="row">
                <dt>Unit price</dt>
                <dd>
                  $<%= (product.unit_amount/100).toFixed(2) %> <%= (product.currency||'usd').toUpperCase() %>
                  <% if (product.interval) { %>/<%= product.interval %><% } %>
                </dd>
              </div>
              <div class="row">

              </div>
              <div class="row total">
                <dt>Total (estimate)</dt>
                <dd><strong>$<%= (total/100).toFixed(2) %> <%= (product.currency||'usd').toUpperCase() %></strong></dd>
              </div>
            </dl>
          </aside>

          <!-- Right column: Trust/Stripe -->
          <div class="trust-col">
            <figure class="trust-figure">
              <img
                class="trust-badge-img"
                src="/images/payments/trust-badge.png?v=<%= page.assetVersion %>"
                alt="Secure payments powered by Stripe"
                decoding="async"
                loading="lazy" />
            </figure>
            <p class="trust-copy">
              Secure payment handled by Stripe. Supports major cards and wallets
              (Apple&nbsp;Pay / Google&nbsp;Pay where available).
            </p>
          </div>

          <!-- Full-width CTAs spanning both columns -->
          <div class="cta-row" role="group" aria-label="Checkout actions">
            <button
              id="continueToPay"
              class="btn btn-primary btn-xl btn-long btn-with-icon"
              data-product="<%= product.key %>"
              data-quantity="<%= quantity %>"
              data-test="continue-to-secure-payment"
              aria-label="Continue to secure payment"
              type="button"
            >
              <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 10V8a5 5 0 0 1 10 0v2h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1zm2 0h6V8a3 3 0 0 0-6 0v2z" fill="currentColor"/>
              </svg>
              <span>Continue to secure payment</span>
            </button>

            <a
              class="btn btn-secondary btn-xl btn-long"
              href="/dashboard/billing"
              data-test="change-selection">
              I'd like to review other options
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
    </div>
  </footer>

  <script nonce="<%= page.nonce %>">
    (function () {
      function csrf() {
        var m = document.querySelector('meta[name="csrf-token"]');
        return m ? m.getAttribute('content') || '' : '';
      }
      
      function cryptoRandom() {
        try {
          var arr = new Uint8Array(16);
          crypto.getRandomValues(arr);
          return Array.from(arr).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
        } catch (e) {
          return String(Date.now()) + Math.random().toString(36).slice(2);
        }
      }
      
      const btn = document.getElementById('continueToPay');
      if (!btn) return;
      
      btn.addEventListener('click', async function () {
        if (btn.disabled) return;
        btn.disabled = true;
        
        const productKey = btn.getAttribute('data-product');
        const qty = parseInt(btn.getAttribute('data-quantity') || '1', 10);
        
        try {
          const res = await fetch('/api/pay/checkout', {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrf(),
              'Idempotency-Key': cryptoRandom()
            },
            credentials: 'include',
            body: JSON.stringify({
              sku: productKey,
              quantity: qty
            })
          });
          
          const data = await res.json().catch(() => ({}));
          
          if (!res.ok || !data.url) {
            throw new Error(data.error || 'Checkout failed');
          }
          
          // Redirect to Stripe Checkout
          window.location.assign(data.url);
        } catch (err) {
          console.error('Checkout error:', err);
          if (window.modalManager?.showNotification) {
            window.modalManager.showNotification('Error', 'Could not start checkout. Please try again.');
          } else {
            alert('Could not start checkout. Please try again.');
          }
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>
  
  <!-- Shared core scripts -->
  <script src="/js/modalManager.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
  
  <!-- Page-specific scripts -->
  <script src="/js/main.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= page.nonce %>"></script>
</body>
</html>
