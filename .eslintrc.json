{
  "root": true,
  "env": { 
    "es2022": true, 
    "node": true, 
    "browser": true 
  },
  "extends": ["eslint:recommended"],
  "parserOptions": { 
    "ecmaVersion": 2022, 
    "sourceType": "module" 
  },
  "rules": {
    "no-console": "error"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/"
  ]
}
