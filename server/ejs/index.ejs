<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= ui.csrfToken || '' %>">
    <% if (typeof APP_CONFIG !== 'undefined') { %>
      <meta id="app-config" 
            data-supabase-url="<%= APP_CONFIG.SUPABASE_URL %>" 
            data-supabase-anon-key="<%= APP_CONFIG.SUPABASE_ANON_KEY %>">
    <% } %>
    <title><%= page?.title || app_info?.name || 'Application' %></title>
    <link rel="icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/css/style.css?v=<%= page.assetVersion || assetVersion || '' %>">
</head>
<body data-auth-hydrate="true">
    <%- include('partials/nav', { nav: page.nav, app_info: app_info }) %>

    <main>
        <div class="container">
            <!-- ============================================================
            SECTION: HERO HEADER
            ============================================================ -->
            <div class="hero">
                <h1>Welcome to <%= app_info?.name || 'Application' %></h1>
                <p class="subtitle"><%= page.description %></p>
            </div>

            <!-- ============================================================
            SECTION: MAIN CONTENT (Master Template Style)
            ============================================================ -->
            <div class="dashboard-actions">
                <h2>About <%= app_info?.name || 'Application' %></h2>
                <p class="subtitle text-center text-muted">
                    Lorem ipsum dolor sit amet consectetur adipisicing elit.
                </p>

                <div class="text-submission">
                    <h3>Overview</h3>
                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. 
                        Quae rerum quasi distinctio fugit ad illo! Nulla voluptatem perspiciatis nemo voluptatum!.
                    </p>
                    <p>
                        Quae quibusdam dolorem natus deleniti earum voluptates magnam assumenda vitae, omnis sint sequi 
                        fuga excepturi laudantium adipisci porro pariatur quas alias? Animi non voluptate unde quos quas 
                        sunt molestiae maxime, ab rerum!.
                    </p>

                    <div class="features">
                        <div class="feature-grid">
                            <div class="feature-card">
                                <h3>Ninja Toaster</h3>
                                <p>
                                    Lorem, ipsum dolor sit amet consectetur adipisicing elit. Rerum facilis illo numquam 
                                    ad qui quis cupiditate, magnam placeat ipsam sint!
                                </p>
                            </div>
                            <div class="feature-card">
                                <h3>Circuit Noodle</h3>
                                <p>
                                    Laudantium, fugit! Laborum nam cupiditate a non veritatis, et doloribus necessitatibus 
                                    debitis tempore iste quaerat nostrum praesentium suscipit tenetur dicta.
                                </p>
                            </div>
                            <div class="feature-card">
                                <h3>Quantum Socket</h3>
                                <p>
                                    Magni dignissimos quibusdam nisi doloremque nulla aliquid illo quos perspiciatis, in 
                                    earum voluptates! Commodi itaque eos expedita ullam aliquam quo?
                                </p>
                            </div>
                        </div>
                    </div>

                    <p class="text-muted mt-one">
                        Praesentium, iure. Eligendi adipisci aperiam quas, error rem autem aut eius maxime saepe harum 
                        veritatis quaerat, vitae facere minus?
                    </p>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 <%= app_info?.name || 'Application' %>. <%= app_info?.description || 'A modern web application' %>.</p>
        </div>
    </footer>

    <!-- Centralized Modals (password change, notifications) -->
    <%- include('partials/modals') %>

    <!-- Shared core scripts -->
    <script
  src="/js/supabase-client.js?v=<%= page.assetVersion || assetVersion || '' %>"
  integrity="sha384-YMVjikuvjBqcUGM8khD0XYqXXIKa8aYRc3Ptvi2nPKveAKdxFl20QG9/12Dwx94a"
  crossorigin="anonymous"
  nonce="<%= cspNonce %>"
></script>
    <script src="/js/sbClient.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= cspNonce %>"></script>
    <script src="/js/logout.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= cspNonce %>"></script>
    <script src="/js/modalManager.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= cspNonce %>"></script>
    <script src="/js/nav-client.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= cspNonce %>"></script>
    
    <!-- Page-specific scripts -->
    <script src="/js/main.js?v=<%= page.assetVersion || assetVersion || '' %>" nonce="<%= cspNonce %>"></script>
</body>
</html>
